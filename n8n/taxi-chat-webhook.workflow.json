{
  "name": "Taxi Chomedey — Chat Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "taxi-chat",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-in",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "taxi-chat"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.deepseek.com/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'deepseek-chat', messages: [{ role: 'system', content: $json.body.systemPrompt || $json.systemPrompt }, ...(($json.body && $json.body.messages) || $json.messages || [])] }) }}",
        "options": {}
      },
      "id": "llm-http",
      "name": "DeepSeek Chat",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [260, 0],
      "notes": "Attach Header Auth credential: Authorization = Bearer YOUR_DEEPSEEK_API_KEY"
    },
    {
      "parameters": {
        "jsCode": "const out = $input.first().json;\nconst text =\n  out?.choices?.[0]?.message?.content ||\n  out?.response ||\n  out?.output ||\n  '';\nreturn [{ json: { response: String(text) } }];"
      },
      "id": "extract",
      "name": "Extract response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { response: $json.response } }}",
        "options": {}
      },
      "id": "respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [780, 0]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "DeepSeek Chat", "type": "main", "index": 0 }]]
    },
    "DeepSeek Chat": {
      "main": [[{ "node": "Extract response", "type": "main", "index": 0 }]]
    },
    "Extract response": {
      "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
